diff --git a/Packages/_Index/evaera_cmdr@1.12.0/cmdr/Cmdr/Shared/Registry.lua b/Packages/_Index/evaera_cmdr@1.12.0/cmdr/Cmdr/Shared/Registry.lua
--- a/Packages/_Index/evaera_cmdr@1.12.0/cmdr/Cmdr/Shared/Registry.lua
+++ b/Packages/_Index/evaera_cmdr@1.12.0/cmdr/Cmdr/Shared/Registry.lua
@@ -212,10 +212,22 @@ function Registry:GetCommands ()
---- Returns an array of the names of all registered commands (not including aliases)
+--- Returns an array of the names and aliases of all registered commands.
 function Registry:GetCommandNames ()
 	local commands = {}
+	local seen = {}
 
 	for _, command in pairs(self.CommandsArray) do
-		table.insert(commands, command.Name)
+		local names = {command.Name}
+		for _, alias in pairs(command.Aliases or {}) do
+			table.insert(names, alias)
+		end
+
+		for _, name in pairs(names) do
+			local normalizedName = name:lower()
+			if not seen[normalizedName] then
+				seen[normalizedName] = true
+				table.insert(commands, name)
+			end
+		end
 	end
 
 	return commands
 end
