 local StarterGui = game:GetService("StarterGui")
+local TextChatService = game:GetService("TextChatService")
 local Window = require(script.Parent.CmdrInterface.Window)
 
+local ANNOUNCEMENT_COLOR = Color3.fromRGB(249, 217, 56)
+local SYSTEM_CHANNEL_TIMEOUT = 5 -- seconds to wait for TextChatService's RBXSystem channel
+
+-- Rich text reads these characters as markup; escaped, an announcement shows them and cannot add tags of its own.
+local function escapeRichText(text)
+	return (text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub("\"", "&quot;"):gsub("'", "&apos;"))
+end
+
+-- Under TextChatService, SetCore's ChatMakeSystemMessage shows nothing, so the announcement goes to RBXSystem.
+local function displaySystemMessage(text)
+	local textChannels = TextChatService:WaitForChild("TextChannels", SYSTEM_CHANNEL_TIMEOUT)
+	local systemChannel = textChannels and textChannels:WaitForChild("RBXSystem", SYSTEM_CHANNEL_TIMEOUT)
+	if not systemChannel or not systemChannel:IsA("TextChannel") then
+		warn("[Cmdr] An announcement was not shown: TextChatService has no RBXSystem channel.")
+		return
+	end
+
+	systemChannel:DisplaySystemMessage(('<font color="#%s">[Announcement] %s</font>'):format(
+		ANNOUNCEMENT_COLOR:ToHex(),
+		escapeRichText(text)
+	))
+end
+
 return function (Cmdr)
 	Cmdr:HandleEvent("Message", function (text)
+		if type(text) ~= "string" or text == "" then
+			return
+		end
+
+		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
+			displaySystemMessage(text)
+			return
+		end
+
 		StarterGui:SetCore("ChatMakeSystemMessage", {
 			Text = ("[Announcement] %s"):format(text);
-			Color = Color3.fromRGB(249, 217, 56);
+			Color = ANNOUNCEMENT_COLOR;
 		})
 	end)
 
